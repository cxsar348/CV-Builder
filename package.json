{
  "name": "cv-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:quick",
    "test:quick": "vitest run",
    "test:full": "npm run test:quick && npm run build && npm audit --audit-level=high",
    "spike:pdf": "tsx scripts/pdf-spike.tsx"
  },
  "dependencies": {
    "@melloware/coloris": "0.25.0",
    "@react-pdf/renderer": "4.9.0",
    "docx": "9.15.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
